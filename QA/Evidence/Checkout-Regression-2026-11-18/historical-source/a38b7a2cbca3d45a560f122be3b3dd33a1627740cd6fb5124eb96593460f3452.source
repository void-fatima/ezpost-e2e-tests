// Generated by Cypress Author — 2026-11-17.
// Pure, private cart-identity oracle. No network, storage or monetary assertions.
// Missing/null artwork means no artwork; number/string IDs remain distinct.
function fail(code) {
  throw Object.assign(new Error(code), { code }); // Never interpolate private values.
}

function check(condition, code) {
  if (!condition) fail(code);
}

function validId(value) {
  return Number.isSafeInteger(value) ||
    (typeof value === 'string' && value.trim().length > 0);
}

function idKey(value) {
  return JSON.stringify([typeof value, value]);
}

function normalized(items) {
  check(Array.isArray(items), 'CHECKOUT_CART_ITEMS_REQUIRED');
  const ids = new Set();
  const rows = Array.from(items, item => {
    check(item && typeof item === 'object' && !Array.isArray(item), 'CHECKOUT_INVALID_CART_LINE');
    check(Object.hasOwn(item, 'id') && validId(item.id), 'CHECKOUT_INVALID_LINE_ID');
    check(!ids.has(idKey(item.id)), 'CHECKOUT_DUPLICATE_LINE_ID');
    ids.add(idKey(item.id));
    check(Object.hasOwn(item, 'product_slug') && typeof item.product_slug === 'string' &&
      item.product_slug.trim().length > 0, 'CHECKOUT_INVALID_PRODUCT_IDENTITY');
    check(Object.hasOwn(item, 'package_id') && validId(item.package_id), 'CHECKOUT_INVALID_PACKAGE_IDENTITY');
    const artwork = item.artwork_id ?? null;
    check(artwork === null || validId(artwork), 'CHECKOUT_INVALID_ARTWORK_IDENTITY');
    check(Object.hasOwn(item, 'quantity') && Number.isSafeInteger(item.quantity) && item.quantity > 0,
      'CHECKOUT_INVALID_CART_QUANTITY');
    return { id: item.id, product_slug: item.product_slug, package_id: item.package_id,
      artwork_id: artwork, quantity: item.quantity };
  });
  return rows.sort((a, b) => {
    const left = idKey(a.id), right = idKey(b.id);
    return left < right ? -1 : left > right ? 1 : 0;
  });
}

function checkedIntent(intent) {
  check(intent && typeof intent === 'object' && !Array.isArray(intent), 'CHECKOUT_INTENT_REQUIRED');
  check(typeof intent.slug === 'string' && intent.slug.trim().length > 0,
    'CHECKOUT_INVALID_INTENDED_PRODUCT');
  check(validId(intent.packageId), 'CHECKOUT_INVALID_INTENDED_PACKAGE');
  check(Number.isSafeInteger(intent.quantity) && intent.quantity > 0,
    'CHECKOUT_INVALID_INTENDED_QUANTITY');
}

function snapshot(items) {
  // This string contains private identities; callers must never persist/log it.
  return JSON.stringify(normalized(items));
}

function ownedLine(beforeItems, afterItems, intent) {
  checkedIntent(intent);
  const before = normalized(beforeItems), after = normalized(afterItems);
  // The whole product must be absent, including other packages/artworks. Do not
  // invent a merge contract or turn an existing user configuration into ours.
  check(before.every(item => item.product_slug !== intent.slug), 'CHECKOUT_PRODUCT_ALREADY_PRESENT');
  const original = new Map(before.map(item => [idKey(item.id), item]));
  const additions = after.filter(item => !original.has(idKey(item.id)));
  check(additions.length === 1, 'CHECKOUT_REQUIRES_ONE_NEW_LINE');
  check(after.length === before.length + 1, 'CHECKOUT_BASELINE_COMPOSITION_CHANGED');
  const remaining = after.filter(item => original.has(idKey(item.id)));
  check(JSON.stringify(remaining) === JSON.stringify(before), 'CHECKOUT_PREEXISTING_INTENT_CHANGED');
  const added = additions[0];
  check(added.product_slug === intent.slug && added.package_id === intent.packageId &&
    added.artwork_id === null, 'CHECKOUT_NEW_LINE_IDENTITY_MISMATCH');
  return added;
}

function identifyOwned(beforeItems, afterItems, intent) {
  // Identity and preservation only: register this ID for safe cleanup BEFORE
  // strict quantity assertions. A wrong positive quantity can then fail cleanly.
  return ownedLine(beforeItems, afterItems, intent).id;
}

function discoverOwned(beforeItems, afterItems, intent) {
  const added = ownedLine(beforeItems, afterItems, intent);
  check(added.quantity === intent.quantity, 'CHECKOUT_NEW_LINE_QUANTITY_MISMATCH');
  return added; // Private canonical row; never export it as public evidence.
}

function restored(beforeItems, afterItems) {
  try { return snapshot(beforeItems) === snapshot(afterItems); }
  catch { return false; } // Invalid data is never a successful restoration.
}

module.exports = { snapshot, identifyOwned, discoverOwned, restored };
