// Generated by Cypress Author — 2026-11-17.
// Client-mounted guest setup; visible SSR form alone is not usable readiness.
let visitSequence = 0;
const sessionPath = '/api/v1/auth/session';

export function visitGuest(path) {
  const alias = 'authenticationGuest' + (++visitSequence);
  cy.intercept('GET', sessionPath).as(alias);
  cy.visit(path);
  cy.wait('@' + alias, { log: false }).then(({ response }) => {
    // Boolean-only errors: an unexpected identity must never enter a report.
    expect(Boolean(response && response.statusCode === 200 && response.body &&
      Object.hasOwn(response.body, 'user') && response.body.user === null),
    'actual client session confirms this independent visit is guest').eq(true);
  });
}

export function assertGuestSession() {
  // The exact read-only session contract is observed in public UI traffic.
  // Never print/store response bodies, identifiers, cookies or headers.
  cy.request({ method: 'GET', url: sessionPath, log: false, failOnStatusCode: false })
    .then(response => {
      expect(Boolean(response.status === 200 && response.body &&
        Object.hasOwn(response.body, 'user') && response.body.user === null),
      'account-link navigation alone does not authenticate a guest').eq(true);
    });
}
