// Generated by Cypress Author — 2026-11-11
export const selectors = {
  phone: '#contact a[href^="tel:"]',
  email: '#contact a[href^="mailto:"]',
  trust: 'footer a[aria-label="مشاهدهٔ اعتبار اینماد ایزی‌پست در سامانهٔ اینماد"]',
  stage: 'main nav[aria-label^="مرحله "]',
  next: 'a[aria-label="مرحلهٔ بعدی"]',
  previous: 'a[aria-label="مرحلهٔ قبلی"]'
};

export function digits(value) {
  return value.replace(/[۰-۹]/g, c => String(c.charCodeAt(0) - 1776))
    .replace(/[٠-٩]/g, c => String(c.charCodeAt(0) - 1632));
}
export function phone(value) {
  return digits(value).replace(/[\s()-]/g, '').replace(/^\+98/, '0');
}
export function localHref(el) {
  const href = el.getAttribute('href');
  expect(href, 'actual nonempty href').to.be.a('string').and.not.be.empty;
  const url = new URL(href, Cypress.config('baseUrl'));
  expect(url.origin, 'same-origin browser navigation').eq(Cypress.config('baseUrl'));
  expect(url.pathname, 'nonempty local pathname').match(/^\//);
  return url;
}
export function stage(number, labels) {
  cy.get(selectors.stage).should('have.length', 1)
    .and('have.attr', 'aria-label', 'مرحله ' + number + ' از ۴');
  cy.get(selectors.stage).find('ol > li').should('have.length', labels.length)
    .each(($li, i) => expect($li.text(), 'ordered stage ' + (i + 1)).contain(labels[i]));
}
export function contactContract() {
  cy.get(selectors.phone).should('be.visible').should($a => {
    expect(phone($a.find('strong').text()), 'display and dial URI agree')
      .eq(phone(decodeURIComponent($a.attr('href').slice(4))));
    expect(phone($a.find('strong').text())).match(/^0[0-9]+$/);
  });
  cy.get(selectors.email).should('be.visible').should($a => {
    expect($a.find('strong').text().trim(), 'display and mail recipient agree')
      .eq(decodeURIComponent($a.attr('href').slice(7)).split('?')[0]);
  });
}
// Test harness cancels native/default AND SPA handling. This is not OS cancellation.
export function cancelHandoff(selector) {
  let record;
  cy.get(selector).should('be.visible').then($a => {
    const link = $a[0];
    const capture = event => {
      if (!event.composedPath().includes(link)) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      record = { href: link.getAttribute('href'), prevented: event.defaultPrevented };
    };
    const win = link.ownerDocument.defaultView;
    win.addEventListener('click', capture, true);
    cy.wrap($a).click().then(() => {
      win.removeEventListener('click', capture, true);
      expect(record, 'browser click captured').to.be.an('object');
      expect(record.prevented, 'default handoff cancelled by harness').eq(true);
      expect(record.href, 'captured destination').eq(link.getAttribute('href'));
    });
  });
}
export function approved(value, caseId, field) {
  expect(value, caseId + ': missing supplied ' + field).to.be.an('object').and.not.eq(null);
  ['source', 'approvedBy', 'version'].forEach(key => {
    expect(value[key], caseId + ': ' + field + '.' + key).to.be.a('string').and.not.be.empty;
  });
  return value;
}
export function expectedPage(expected) {
  expect(expected, 'supplied destination contract').to.be.an('object');
  expect(expected.pathname).to.be.a('string').and.match(/^\//);
  expect(expected.search, 'explicit query, including empty string').to.be.a('string');
  expect(expected.heading, 'reviewed visible main identity').to.be.a('string').and.not.be.empty;
  cy.location('pathname').should('eq', expected.pathname);
  cy.location('search').should('eq', expected.search);
  cy.get('main h1').should('be.visible').and('have.text', expected.heading);
}
export function emptyGuest() {
  cy.intercept('GET', '/api/v1/auth/session').as('session');
  cy.visit('/cart');
  cy.wait('@session').its('response.body.user').should('eq', null);
  cy.get('main h2').should('be.visible').and('have.text', 'سبد هنوز خالی است.');
}

