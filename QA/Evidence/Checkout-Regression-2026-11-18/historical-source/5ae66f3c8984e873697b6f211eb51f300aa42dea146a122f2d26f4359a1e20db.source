// Generated by Cypress Author — 2026-11-17.
// Separate authorized owned-cart slice. Historical read-only/auth guards unchanged.
import contract from './authenticated-session-contract.cjs';
import { createAuthSequence } from './checkout-auth-sequence.cjs';
import owned from './authenticated-checkout-contract.cjs';
import { installCheckoutRuntime } from './authenticated-checkout-runtime';

const origin = 'http://172.16.30.198:5800';
const startPath = '/api/v1/auth/otp/start';
const verifyPath = '/api/v1/auth/otp/verify';
let gate;

function safePath(pathname) {
  return ['/cart', '/login', '/account', '/checkout', '/products/simple', '/products/blackfri-01'].includes(pathname) ? pathname : '[UNREVIEWED-PATH]';
}

function guestSourceEmpty(doc) {
  try {
    const raw = doc?.defaultView?.localStorage.getItem('ezpost_guest_cart_v1');
    if (raw === null) return true;
    const items = JSON.parse(raw);
    return Array.isArray(items) && items.length === 0;
  } catch { return false; } // Unknown state is a failed prerequisite, never cleared.
}

beforeEach(() => {
  let mobileAnchor, sessionIdentity, resolveVerification, candidate;
  const auth = createAuthSequence();
  const ownership = owned.createOwnershipLifecycle({
    singleWriterConfirmed: Cypress.expose('checkoutSingleWriterConfirmed') === true
  });
  let addCount = 0, removeCount = 0;
  const verification = new Cypress.Promise(resolve => { resolveVerification = resolve; });
  const status = { phase: 'preflight', manualAssisted: true, otpStartCount: 0,
    otpVerifyCount: 0, blockedMutations: 0, checks: {}, cleanup: 'not-started' };
  const publish = () => {
    Object.assign(status, auth.snapshot());
    status.ownership = ownership.status();
    Cypress.expose('authenticatedCheckoutStatus', JSON.parse(JSON.stringify(status)));
  };
  gate = {
    status,
    phase(value, pathname) { status.phase = value; if (pathname) status.pathname = safePath(pathname); publish(); },
    check(name, value) { status.checks[name] = Boolean(value); publish(); expect(Boolean(value), name).eq(true); },
    waitForVerification() { return verification; },
    validAuthSequence() { return auth.validCompletedSequence(); },
    matchesSession(user) { return contract.intendedOrdinaryUser(user, mobileAnchor); },
    matchesMe(user) { return contract.intendedMe(user, mobileAnchor); },
    rememberSession(user) {
      sessionIdentity = user.id;
      publish();
    },
    sameSession(user) { return contract.intendedOrdinaryUser(user, mobileAnchor) && user.id === sessionIdentity; },
    matchesDisplayedMobile(value) { return contract.displayDigits(value) === mobileAnchor; },
    armAdd(intent) { ownership.arm(intent); candidate = intent; publish(); },
    registerOwned(before, after) {
      const id = ownership.establish(before, after);
      status.cleanup = 'owned-registered'; publish(); return id;
    },
    ownershipStatus() { return ownership.status(); },
    ownedId() { return ownership.ownedId(); },
    assertOwnedCleanup() { return ownership.assertCleanupOwned(ownership.ownedId()); },
    verifyRestored(values) {
      return owned.assertRestored({ ...values, expectedMobile: mobileAnchor,
        expectedUserId: sessionIdentity, ownedId: ownership.ownedId() });
    },
    cleanup(value) { status.cleanup = value; publish(); },
    counts() { return { addCount, removeCount }; }
  };
  installCheckoutRuntime(gate);
  publish();

  // Public login module inspected 2026-11-18: this button is rendered only
  // after cooldown, disabled while busy, and calls the normal resendOtp.
  // Observe the trusted user click in capture phase; never click/enable it.
  cy.on('window:before:load', win => {
    win.document.addEventListener('click', event => {
      const button = event.target?.closest?.('main button.auth-resend-btn[type="button"]');
      if (!button) return;
      auth.armResend({ phase: status.phase, trusted: event.isTrusted,
        normalUiControl: button.ownerDocument === win.document &&
          win.location.pathname === '/login' &&
          win.document.querySelectorAll('main [data-cy="otp-inputs"] input').length === 6,
        enabled: !button.disabled && button.getClientRects().length > 0 &&
          !win.document.querySelector('main .auth-timer-count') });
      publish();
    }, true);
  });

  function deny(req, code) {
    status.blockedMutations++;
    status.phase = 'failed';
    publish();
    req.destroy();
    resolveVerification({ succeeded: false, failureCode: code });
    throw new Error(code); // Fail closed; never swallow a rejected action.
  }

  cy.intercept({ url: origin + '/**', middleware: true }, req => {
    const url = new URL(req.url);
    if (['GET', 'HEAD', 'OPTIONS'].includes(req.method)) return;
    // Same observed read-only quote exception as the unchanged global guard.
    // Authenticated cart rendering requests these; this grants no cart write.
    if (req.method === 'POST' && /^\/api\/v1\/products\/[^/]+\/quote$/.test(url.pathname)) return;
    // Actual public client contract: one normal Add, then only owned-ID Remove.
    // No quantity changes, shipping, checkout, address saves or order writes.
    if (req.method === 'POST' && url.pathname === '/api/v1/cart/items' && !url.search) {
      if (status.phase !== 'adding-owned-item' || !candidate || addCount !== 0 ||
          !guestSourceEmpty(Cypress.state('window')?.document) ||
          !contract.exactKeys(req.body, ['product_slug', 'package_id', 'quantity']) ||
          req.body.product_slug !== candidate.slug || req.body.package_id !== candidate.packageId ||
          req.body.quantity !== candidate.quantity) return deny(req, 'CHECKOUT_ADD_OUTSIDE_EXACT_INTENT');
      try { ownership.permitAdd(req.body); }
      catch (error) { return deny(req, error.code); }
      addCount++; publish();
      req.on('after:response', res => { ownership.observeAddResponse(res.statusCode); publish(); });
      return;
    }
    if (req.method === 'POST' && ownership.ownedId() !== undefined && !url.search &&
        url.pathname === '/api/v1/cart/items/' + encodeURIComponent(ownership.ownedId()) + '/remove') {
      if (status.phase !== 'cleanup' || removeCount !== 0 || ![undefined, null, ''].includes(req.body)) {
        return deny(req, 'CHECKOUT_REMOVE_OUTSIDE_OWNED_CLEANUP');
      }
      try { ownership.permitRemove(ownership.ownedId()); }
      catch (error) { return deny(req, error.code); }
      removeCount++; publish(); return;
    }
    if (req.method !== 'POST' || url.search || ![startPath, verifyPath].includes(url.pathname)) {
      return deny(req, 'AUTH_SCOPE_FORBIDS_NON_AUTH_MUTATION');
    }
    const doc = Cypress.state('window')?.document;
    const fields = [...(doc?.querySelectorAll('main [data-cy="otp-inputs"] input') || [])];
    let kind;
    try {
      kind = auth.permit({ method: req.method, pathname: url.pathname, search: url.search,
        body: req.body, phase: status.phase, guestEmpty: guestSourceEmpty(doc),
        manualMobile: doc?.querySelector('main #mobile')?.value,
        otpValues: fields.map(field => field.value) });
    } catch (error) { return deny(req, error.code); }
    if (kind === 'start' || kind === 'resend') {
      if (kind === 'start') mobileAnchor = req.body.mobile; // Private memory only.
      publish();
      req.on('after:response', res => {
        if (!auth.completeStart(res.statusCode)) {
          status.phase = 'failed'; publish();
          resolveVerification({ succeeded: false, failureCode: 'AUTH_START_RESPONSE_FAILED' });
          return;
        }
        status.phase = 'awaiting-otp'; publish();
      });
      return;
    }
    status.phase = 'verifying'; publish();
    req.on('after:response', res => {
      const succeeded = auth.completeVerify(res.statusCode);
      // HTTP success only starts independent identity checks; it is not login proof.
      status.phase = succeeded ? 'checking-session' : 'failed';
      publish();
      resolveVerification({ succeeded, failureCode: succeeded ? null : 'AUTH_VERIFY_RESPONSE_FAILED' });
    });
  });
});
